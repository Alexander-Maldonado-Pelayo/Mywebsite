# Copy this file to .env and fill in your values.

# Server
PORT=3000
NODE_ENV=development

# Secret used to sign login tokens. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# First admin account, created automatically on first run (npm run seed).
ADMIN_NAME=CAG Admin
ADMIN_EMAIL=cagconstructiona@gmail.com
ADMIN_PASSWORD=changeme123

# Email notifications (optional).
# If these are left blank, the app logs emails to the console instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CAG Construction <cagconstructiona@gmail.com>"
# Where new-lead / new-booking alerts go (defaults to ADMIN_EMAIL).
NOTIFY_EMAIL=
